		</visible>
		<target> &true; </target>
		<filename> Interface\Misc\blueprint.dds </filename>
		<systemcolor>0</systemcolor>
		<depth> 30 </depth>
		<width> 990 </width>
		<height> 990 </height>
<zoom> &scale; </zoom>
		<wheelable> &true; </wheelable>
		<x>
			<copy src="screen()" trait="width"/>
			<sub src="me()" trait="width"/>
			<div> 2 </div>
		</x>
		<y>
			<copy src="screen()" trait="height"/>
