			</visible>
			<depth> 6 </depth>
			<x> 600 </x>
			<y> 765 </y>
			<string> &-sNext; </string>
			<clicksound>
				<copy src="BookMenu" trait="user8"/>
			</clicksound>
			<_xbox_button> &xbuttonrt; </_xbox_button>
      <xdefault> &xboxhint; </xdefault>
			<xleft>
				<ref src="book_prev" trait="mouseover"/>
			</xleft>
			<xright>
				<ref src="book_exit" trait="mouseover"/>
			</xright>
			<red> <copy src="book_page_1_text" trait="red"/></red>
     	<green> <copy src="book_page_1_text" trait="green"/></green>
    	<blue> <copy src="book_page_1_text" trait="blue"/></blue>
			<systemcolor> &uselocalcolor; </systemcolor>
		</image>

		<hotrect name="book_exit">
			<include src="book_text_box.xml"/>
			<id> 31 </id>
			<target> &true; </target>
			<visible> &true; </visible>
			<depth> 6 </depth>
			<alpha> 0 </alpha>
			<x>
				<copy> 40 </copy>
				<onlyif> &xbox; </onlyif>
				<add> 1110 </add>
				<sub src="me()" trait="width"/>
			</x>
			<y> 765 </y>
			<string> &-sExit; </string>
			<_xbox_button> &xbuttonb; </_xbox_button>
      <xdefault> &xboxhint; </xdefault>
			<xleft>
				<ref src="book_next" trait="mouseover"/>
			</xleft>
			<xright>
				<ref src="book_take" trait="mouseover"/>
			</xright>
			<red> <copy src="book_page_1_text" trait="red"/></red>
     	<green> <copy src="book_page_1_text" trait="green"/></green>
    	<blue> <copy src="book_page_1_text" trait="blue"/></blue>
			<systemcolor> &uselocalcolor; </systemcolor>
		</hotrect>
	</image>

	<!--===================================================================================-->
