		</y>
		<locus> &true; </locus>
		<user0> 0 </user0> 		<!-- number of lines - set by code -->

		<xbuttonb>
			<ref src="book_scroll_exit" trait="clicked"/>
		</xbuttonb>
		<xbuttonx>
			<ref src="book_scroll_take" trait="clicked"/>
