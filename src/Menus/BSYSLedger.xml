				<copy> 47 </copy>
				<onlyif> &xbox; </onlyif>
				<add> 553 </add>
				<sub src="me()" trait="width"/>
			</x>
			<y> 765 </y>
			<string> &-sKBPrevtrack; </string>
			<clicksound>
				<copy src="BookMenu" trait="user8"/>
			</clicksound>
			<_xbox_button> &xbuttonlt; </_xbox_button>
			<xdefault> &xboxhint; </xdefault>
			<xleft>
				<ref src="book_take" trait="mouseover"/>
			</xleft>
			<xright>
				<ref src="book_next" trait="mouseover"/>
			</xright>
			<red> <copy src="book_page_1_text" trait="red"/></red>
     	<green> <copy src="book_page_1_text" trait="green"/></green>
    	<blue> <copy src="book_page_1_text" trait="blue"/></blue>
			<systemcolor> &uselocalcolor; </systemcolor>
		</hotrect>
		<text name="book_page_1_num">
			<visible> &true; </visible>
			<target> &xbox; </target>
			<depth> 6 </depth>
			<x> 300 </x>
			<y> 765 </y>
			<justify> &center; </justify>
			<_page1>
				<copy src="parent()" trait="_pagenum"/>
				<add> 1 </add>
			</_page1>
			<string>
				<copy src="me()" trait="_page1"/>
			</string>
    	<red> <copy src="book_page_1_text" trait="red"/></red>
     	<green> <copy src="book_page_1_text" trait="green"/></green>
    	<blue> <copy src="book_page_1_text" trait="blue"/></blue>
			<alpha> <copy src="book_page_1_text" trait="alpha"/> </alpha>
      <xdefault> 10 </xdefault>

		</text>
		<text name="book_page_2_num">
			<visible> &true; </visible>
			<depth> 6 </depth>
			<x> 850 </x>
			<y> 765 </y>
			<justify> &center; </justify>
			<_page2>
				<copy src="parent()" trait="_pagenum"/>
				<add> 2 </add>
			</_page2>
			<string>
				<copy src="me()" trait="_page2"/>
			</string>
      <red> <copy src="book_page_1_text" trait="red"/></red>
     	<green> <copy src="book_page_1_text" trait="green"/></green>
    	<blue> <copy src="book_page_1_text" trait="blue"/></blue>
			<alpha> <copy src="book_page_1_text" trait="alpha"/> </alpha>

		</text>
		<image name="book_next">
			<include src="book_text_box.xml"/>
			<id> &generic; </id>
			<target> &true; </target>
			<visible>
				<copy src="parent()" trait="_pagenum"/>
