; ============================================================================
; BSYS_NoteRefreshUDF
; ============================================================================
; (Re)creates the per-item "new location" Pip-Boy notes for every ledger
; row whose intel was ever bought (LedgerIntel bit 1 = revealed, or bit 8
; = note granted before churn reset the revealed bit - the purchased note
; must outlive the item moving on). Called on every load (InitLoadUDF,
; both paths) and after each new reveal (IntelPayUDE).
;
; TempCloneForm, not a Plugins+ instance: the P+ NOTE instance rendered a
; BLANK text pane in the Pip-Boy viewer (in-game tested), while v1's
; TempCloneForm notes rendered fine. Clones never survive a session -
; that's the design: the engine drops the stale list entry at load, and
; this pass re-clones, re-dresses and silently re-grants (AddNoteNS).
; The note reports the SNAPSHOT taken when the intel was bought
; (LedgerIntelVendor): if the item churns onward later, the note stays as
; the fence told it - fresh intel (new checks) is needed for the new spot.
;
; Title: "<prefix> x<N> <item> <suffix>" = "Benny's Ledger - x3 Scrap
; Metal New Location". LedgerIntel bit 8 = "granted once": the very first
; grant uses vanilla AddNote (corner message), re-grants use AddNoteNS.
; Session bookkeeping in *_BSYS_IntelNoteRow/Ref pairs (for uninstall and
; same-session dedupe).
; ============================================================================

Create: BSYS_NoteRefreshUDF

ref rBase
ref rNote
ref rItem
ref rCur
string_var sTitle
string_var sText
string_var sLoc
string_var sLabel
int iNum
int iIdx
int iMask
int iQty
int iSes
int iSesNum
int bHave

Begin Function {}
  let rBase := GetFormFromMod "FalloutNV.esm" "1669B0" ; V19MedNote05

  if rBase == 0
    return
  endif

  let iNum := Player.AuxVarSize "_BSYS_LedgerForm"
  let iIdx := 0

  while iIdx < iNum
    let iMask := Player.AuxVarGetFlt "_BSYS_LedgerIntel" iIdx

    if eval (iMask & 9) == 0 ; never revealed, no note ever granted
      let iIdx += 1
      continue
    endif

    ; Already cloned this session? Then re-dress in place (a re-reveal
    ; after churn updates the snapshot and the note must follow)
    let bHave := 0
    let rNote := 0
    let iSesNum := Goo1.AuxVarSize "*_BSYS_IntelNoteRow"
    let iSes := 0

    while iSes < iSesNum
      if (Goo1.AuxVarGetFlt "*_BSYS_IntelNoteRow" iSes) == iIdx
        let bHave := 1
        let rNote := Goo1.AuxVarGetRef "*_BSYS_IntelNoteRef" iSes
        break
      endif

      let iSes += 1
    loop

    let rItem := Player.AuxVarGetRef "_BSYS_LedgerForm" iIdx
    let iQty := Player.AuxVarGetFlt "_BSYS_LedgerQty" iIdx

    ; The note reports the SNAPSHOT the fence sold - not the live spot.
    ; A sentinel snapshot (no real vendor recorded) mints no note.
    let rCur := Player.AuxVarGetRef "_BSYS_LedgerIntelVendor" iIdx

    if rCur == 0 || rCur == BennyREF
      let iIdx += 1
      continue
    endif

    if rNote == 0
      let rNote := TempCloneForm rBase
    endif

    if rNote == 0
      let iIdx += 1
      continue
    endif

    ; The TITLE carries the location: the note text pane never renders
    ; runtime-written TNAM (both the P+ instance and TempCloneForm bodies
    ; came up blank in-game - the viewer reads the text through an
    ; unhooked path), and the title is the one field that provably shows.
    ; "Benny's Ledger - x3 Scrap Metal: Old Lady Gibson, Gibson's Scrap Yard"
    let sLabel := Call BSYS_TranslateUDF "BSYS_intelNotePrefix"
    let sTitle := $sLabel + " x" + $iQty + " " + (LNGetName rItem) + ": " + (LNGetName rCur)
    let sLoc := Call BSYS_VendorLocUDF rCur

    if (sv_Length sLoc) > 0
      let sTitle += ", " + $sLoc
    endif

    SetName ($sTitle) rNote

    ; Body rebuilt live: follows the item if it churns again
    let sText := Call BSYS_TranslateUDF "BSYS_intelReveal"
    let sText += " " + (LNGetName rItem) + " "
    let sLabel := Call BSYS_TranslateUDF "BSYS_intelRevealEnd"
    let sText += $sLabel + " " + (LNGetName rCur)
    let sLoc := Call BSYS_VendorLocUDF rCur

    if (sv_Length sLoc) > 0
      let sLabel := Call BSYS_TranslateUDF "BSYS_ledgerIn"
      let sText += " " + $sLabel + " " + $sLoc
    endif

    SetFormDescription rNote ($sText)

    ; First grant announces itself; every re-grant is silent
    if eval (iMask & 8)
      if (Player.GetHasNote rNote) == 0
        AddNoteNS rNote
      endif
    else
      AddNote rNote
      Player.AuxVarSetFlt "_BSYS_LedgerIntel" (iMask + 8) iIdx
    endif

    if bHave == 0
      Goo1.AuxVarSetFlt "*_BSYS_IntelNoteRow" iIdx -1
      Goo1.AuxVarSetRef "*_BSYS_IntelNoteRef" rNote -1
    endif

    let iIdx += 1
  loop
End
