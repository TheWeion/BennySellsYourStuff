; ============================================================================
; BSYS_UninstallUDF
; ============================================================================
; Clean removal, run once per save load while DangerZone:bUninstall=1:
; settle any unfinished spree (skipped if BHYSYS is gone), wipe every
; AuxVar including the _BSYS_iEnded sentinel, then tell the player to
; save and remove the mod. InitLoadUDF never runs while uninstalling, so
; nothing registers and both heartbeats stay inert for the session.
; ============================================================================

Create: BSYS_UninstallUDF

ref rSafe
ref rBook
ref rOwner
ref rChest
ref rNote
int iCount
int iNoteIdx
string_var sMsg

Begin Function {}
  ; --- 1. Settle what's still owed ---
  ; Classic-vanish only: the wipe below erases the ledger rows, so items
  ; physically fenced during this final settle would be untraceable
  Goo1.AuxVarSetFlt "*_BSYS" 0 26 ; FencingNetwork:bPhysicalFencing

  if (Player.AuxVarGetFlt "_BSYS_fStartDay") > 0 && (Player.AuxVarGetFlt "_BSYS_iEnded") == 0
    let rSafe := EditorIDToFormID "SSSStolenWeaponsRef"

    if rSafe
      Goo1.AuxVarSetRef "*_BSYS_rSafe" rSafe
      Goo1.AuxVarSetRef "*_BSYS_rNote" (EditorIDToFormID "sssBennyGearNote")
      Goo1.AuxVarSetRef "*_BSYS_rKey" (EditorIDToFormID "BennySafeKey")

      Call BSYS_SimUDF
    endif
  endif

  ; --- 2. The ledger book dies with the mod - pull it before the wipe ---
  ; (*_BSYS_rBook is set by BSYS_BookReconUDE when the instance came back
  ; this load; owner must be read before CleanupUDF erases it. The
  ; per-save _BSYS_sBookDesc guard keeps a session-leaked ref from another
  ; save from being touched on a save that never had a book)
  let rBook := Goo1.AuxVarGetRef "*_BSYS_rBook"
  let rOwner := Player.AuxVarGetRef "_BSYS_rBookOwner"

  if (Player.AuxVarSize "_BSYS_sBookDesc") == 0
    let rBook := 0
  endif

  if rBook
    if rOwner
      ; A sold book physically sits in the vendor's MERCHANT CHEST, not
      ; on the owner actor - resolve the real home like BookGuardUDF does
      ; and pull from both, or DeleteFormInstance would orphan a chest
      ; entry on a freed form. (Hoisted counts: an inline ref-called
      ; command in a classic arg is a compile-killer)
      let rChest := rOwner.GetMerchantContainer

      if rChest == 0
        let rChest := rOwner
      endif

      let iCount := rChest.GetItemCount rBook

      if iCount > 0
        rChest.RemoveItem rBook iCount 1
      endif

      if rChest != rOwner
        let iCount := rOwner.GetItemCount rBook

        if iCount > 0
          rOwner.RemoveItem rBook iCount 1
        endif
      endif
    endif

    DeleteFormInstance rBook
    Goo1.AuxVarErase "*_BSYS_rBook"
  endif

  ; --- 3. Full wipe, sentinel included ---
  Call BSYS_CleanupUDF 1

  ; --- 4. Hand the save back to the player ---
  let sMsg := Call BSYS_TranslateUDF "BSYS_uninstallMessage"
  MessageBoxEx ($sMsg)

  if Goo1.AuxVarGetFlt "*_BSYS" 1
    Print "BSYS - Uninstall: spree settled, all mod data removed."
  endif
End
