; ============================================================================
; BSYS_PauseUDF
; ============================================================================
; Pause bookkeeping for a save with a running clock while the mod is
; off (bEnabled=0). Called from either heartbeat while disabled.
; ============================================================================

Create: BSYS_PauseUDF

float fNow
float fLast
int iRows
int iRowIdx

Begin Function {}
  if Player.AuxVarGetFlt "_BSYS_fStartDay" == 0
    return
  endif
  if Player.AuxVarGetFlt "_BSYS_iEnded"
    return
  endif

  let fNow := GetGameDaysPassed ; already includes the GameHour/24 fraction
  let fLast := Player.AuxVarGetFlt "_BSYS_fLastSimDay"

  ; Signed delta: forward drift (play, waits, jumps ahead) is pinned so it
  ; never banks; a backward jump rebases the same way, keeping the anchors
  ; consistent with the new "now" instead of stranded in the future
  if fNow != fLast
    ; Ledger stamps are absolute - pin them along with the anchors so the
    ; book's day numbers stay consistent across the pause
    let iRows := Player.AuxVarSize "_BSYS_LedgerDay"
    let iRowIdx := 0

    while iRowIdx < iRows
      Player.AuxVarSetFlt "_BSYS_LedgerDay" ((Player.AuxVarGetFlt "_BSYS_LedgerDay" iRowIdx) + (fNow - fLast)) iRowIdx
      let iRowIdx += 1
    loop

    ; Pin the churn stamps too, or disabled time banks toward migration
    let iRows := Player.AuxVarSize "_BSYS_LedgerMoveDay"
    let iRowIdx := 0

    while iRowIdx < iRows
      Player.AuxVarSetFlt "_BSYS_LedgerMoveDay" ((Player.AuxVarGetFlt "_BSYS_LedgerMoveDay" iRowIdx) + (fNow - fLast)) iRowIdx
      let iRowIdx += 1
    loop

    Player.AuxVarSetFlt "_BSYS_fStartDay" (Player.AuxVarGetFlt "_BSYS_fStartDay" + (fNow - fLast))
    Player.AuxVarSetFlt "_BSYS_fLastSimDay" fNow
  endif
End
