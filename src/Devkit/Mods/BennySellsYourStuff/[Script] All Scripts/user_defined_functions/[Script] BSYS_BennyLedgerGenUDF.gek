; ============================================================================
; BSYS_BennyLedgerGenUDF
; ============================================================================
; Creates the ledger book once, from BSYS_BookSpawnUDF, on whichever Benny
; ref died. The Plugins+ instance and its placement are serialized into the
; co-save and restored on every load; only the dressing is memory-only,
; which BSYS_BookReconUDE re-does on each reconstruct. The AddItemAlt
; below is the book's one CREATION add; BSYS_BookGuardUDF re-seats the
; same instance at vendor chests when Plugins+ drops it, never a second
; copy.
; ============================================================================

Create: BSYS_BennyLedgerGenUDF

ref rInst
ref rOwner

Begin Function {}
  let rInst := CreateFormInstance BookSkillScience "BSYS"
  Call BSYS_BookReconUDE rInst

  ; Initial placement on the corpse (BookSpawnUDF set the owner just before)
  let rOwner := Player.AuxVarGetRef "_BSYS_rBookOwner"

  if rOwner
    rOwner.AddItemAlt rInst 1
  endif
End
