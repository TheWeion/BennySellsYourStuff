; ============================================================================
; BSYS_BennyLedgerGenUDF
; ============================================================================
; Creates the ledger book once, from BSYS_BookSpawnUDF, on whichever Benny
; ref died - or on the player, when it changes hands on the cross (bLoud:
; let the engine print its "added" line). The Plugins+ instance and its
; placement are serialized into the co-save and restored on every load;
; only the dressing is memory-only, which BSYS_BookReconUDE re-does on
; each reconstruct. The AddItemAlt below is the book's one CREATION add;
; BSYS_BookGuardUDF re-seats the same instance at vendor chests when
; Plugins+ drops it, never a second copy.
; ============================================================================

Create: BSYS_BennyLedgerGenUDF

ref rInst
ref rOwner
int bLoud

Begin Function { bLoud }
  let rInst := CreateFormInstance BookSkillScience "BSYS"
  Call BSYS_BookReconUDE rInst

  ; Initial placement on the recorded owner - the corpse, or the player on
  ; the cross (BookSpawnUDF set it just before)
  let rOwner := Player.AuxVarGetRef "_BSYS_rBookOwner"

  if rOwner
    if bLoud
      rOwner.AddItemAlt rInst 1 100 0 0
    else
      rOwner.AddItemAlt rInst 1
    endif
  endif
End
